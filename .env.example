DATABASE_URL="postgresql://postgres@localhost:5432/mvpfactory?schema=public"
# Future integrations only; DEMO does not read or use these values.
LLM_API_KEY=
SUPABASE_ACCESS_TOKEN=
GITHUB_TOKEN=
VERCEL_TOKEN=
# 데모 워커가 발언·단계 사이에 두는 지연(ms). 필수이며 기본값이 없다.
WORKER_DEMO_DELAY_MS=5000
# DB를 쓰는 테스트 전용 DB. 없으면 DATABASE_URL의 DB 이름 뒤에 _test를 붙여 쓴다. 개발 DB와 반드시 달라야 한다.
# TEST_DATABASE_URL=

# 새 실행의 기본 한도. DB에서 저장한 값이 우선하며, 빈 값은 아래 기본값을 사용합니다.
DEFAULT_MAX_MODEL_CALLS=50
DEFAULT_MAX_FIX_ATTEMPTS=3
DEFAULT_MAX_ACTIVE_SECONDS=1800
DEFAULT_MAX_ESTIMATED_COST_USD=5
