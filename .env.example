DATABASE_URL="postgresql://postgres@localhost:5432/mvpfactory?schema=public"
# Future integrations only; DEMO does not read or use these values.
LLM_API_KEY=
# 회의·PM·기획·설계에 쓰는 OpenAI 모델 이름(DEC-002). 예: gpt-5.4
LLM_MODEL=
# 코드 작성·수정은 로그인된 Codex CLI를 사용합니다. 기본 실행 파일은 codex입니다.
# CODEX_CLI_PATH=/absolute/path/to/codex
# 선택: 비어 있으면 Codex CLI 기본 모델 사용(사용자 config.toml은 로드하지 않음).
# CODEX_MODEL=
# 선택: 모델 단가(USD/100만 토큰). 둘 다 넣어야 예상 비용을 계산한다. 없으면 비용은 기록하지 않고 비용 한도는 적용되지 않는다.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# 생성 소스를 샌드박스 밖에 보존하는 폴더. 기본 .data/source-snapshots
# SOURCE_SNAPSHOT_DIR=
# 생성 앱 DB를 관리하는 전용 Management API 토큰
SUPABASE_ACCESS_APP_TOKEN=
# DB가 필요한 생성 앱이 쓰는 공용 Supabase 프로젝트의 참조 ID(DEC-005: 프로젝트 1개, 앱마다 스키마, 서울)
SUPABASE_PROJECT_REF=
GITHUB_TOKEN=
VERCEL_TOKEN=
# 데모 워커가 발언·단계 사이에 두는 지연(ms). 필수이며 기본값이 없다.
WORKER_DEMO_DELAY_MS=5000
# DB를 쓰는 테스트 전용 DB. 없으면 DATABASE_URL의 DB 이름 뒤에 _test를 붙여 쓴다. 개발 DB와 반드시 달라야 한다.
# TEST_DATABASE_URL=

# 새 실행의 기본 한도. DB에서 저장한 값이 우선하며, 빈 값은 아래 기본값을 사용합니다.
DEFAULT_MAX_MODEL_CALLS=50
DEFAULT_MAX_FIX_ATTEMPTS=3
DEFAULT_MAX_ACTIVE_SECONDS=1800
DEFAULT_MAX_ESTIMATED_COST_USD=5
