{
  "name": "mvpfactory",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "prisma/schema"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "tasks": "tsx scripts/tasks.ts",
    "tasks:check": "tsx scripts/tasks.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@prisma/client": "^6.12.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "pixi.js": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "prisma": "^6.12.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
