/// 모든 프로젝트가 공유하는 회사·캐릭터 설정. 행은 하나다.
/// JSON 형식은 서버가 저장 시점에 src/contracts/company.ts 기준으로 검증한다.
model CompanyLayout {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  /// 저장할 때마다 증가. 동시 편집 충돌 감지에 사용한다.
  version     Int       @default(1)
  /// Record<RoleId, CharacterAppearance>
  characters  Json
  /// OfficeLayout(확장 단계, 배치, 회의 좌석)
  office      Json
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}
