/// 폐기된 꾸미기 데이터의 호환용 정의. API·Prisma Client에서 접근하지 않는다.
model CompanyLayout {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  /// 저장할 때마다 증가. 동시 편집 충돌 감지에 사용한다.
  version     Int       @default(1)
  /// Record<RoleId, CharacterAppearance>
  characters  Json
  /// OfficeLayout(확장 단계, 배치, 회의 좌석)
  office      Json
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  @@ignore
}
